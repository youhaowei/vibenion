#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo 'usage: vibenion-event <session_id> <agent> <state> <summary> [title] [terminal] [elapsed] [message] [terminal_metadata_json]' >&2
  exit 2
}

if [ "$#" -lt 4 ]; then
  usage
fi

log_dir="${VIBENION_DIR:-$HOME/.vibenion}"
log_file="$log_dir/events.jsonl"
mkdir -p "$log_dir"

python3 - "$@" >> "$log_file" <<'PY'
import json
import sys

session_id, agent, state, summary = sys.argv[1:5]
optional = sys.argv[5:]
keys = ["title", "terminal", "elapsed", "message", "terminal_metadata"]

event = {
    "session_id": session_id,
    "agent": agent,
    "state": state,
    "summary": summary,
}

for key, value in zip(keys, optional):
    if value:
        event[key] = json.loads(value) if key == "terminal_metadata" else value

print(json.dumps(event, separators=(",", ":")))
PY
